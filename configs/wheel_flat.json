{
  "run": {
    "seed": 7,
    "updates": 100,
    "warmup_steps": 128,
    "collection_steps": 3,
    "replay_steps": 256,
    "model_batches": 10,
    "model_batch_size": 256,
    "imagination_batch_size": 256,
    "validation_batch_size": 128,
    "validation_fraction": 0.125,
    "action_noise_std": 0.1,
    "checkpoint_interval": 10,
    "tensorboard": true
  },
  "learning": {
    "model_hidden": [512, 512, 512],
    "actor_hidden": [256, 128, 64],
    "critic_hidden": [256, 128, 64],
    "history_length": 5,
    "fit_horizon": 8,
    "imagination_horizon": 32,
    "learning_rate": 0.0002,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "critic_epochs": 5,
    "critic_minibatches": 4,
    "gradient_clip": 1.0,
    "actor_element_clip": 0.1
  }
}
